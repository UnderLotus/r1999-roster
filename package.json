{
  "name": "r1999-roster",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:store": "tsx scripts/test-store.ts",
    "test:share": "tsx scripts/test-share-code.ts",
    "test:names": "tsx scripts/test-names.ts",
    "test:assets": "tsx scripts/test-assets.ts",
    "build:names": "tsx scripts/build-names.ts",
    "build:id-map": "tsx scripts/build-id-map.ts",
    "build:characters": "tsx scripts/build-characters.ts",
    "preview": "vite preview",
    "sync": "tsx scripts/sync-assets.ts",
    "sync:wiki": "tsx scripts/sync-wiki-list.ts",
    "sync:fandom": "tsx scripts/sync-fandom.ts",
    "update": "npm run sync && npm run build:characters && npm run sync:wiki && npm run build:names && npm run sync:fandom"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "modern-screenshot": "^4.4.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
